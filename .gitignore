# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.venv/
.venv*/
env/

# =============================================================================
# DONNEES SENSIBLES — NE JAMAIS VERSIONNER
# Ces fichiers contiennent des informations sur le domaine AD de production :
# comptes, politiques de mot de passe, faiblesses de securite.
# Voir AUDIT_2026-07-20.md (constat C2).
# =============================================================================
data/audit_history/
data/settings.json
data/permissions.json
data/crypto_salt.bin
data/backups/
data/sessions/
data/user_templates.json
logs/

# core/settings_manager.py resout son fichier via os.path.dirname(__file__),
# donc core/data/ (et non data/) : meme risque que ci-dessus si non couvert
# (core/data/settings.json et core/data/crypto_salt.bin ont deja fuite,
# suivis par erreur avant l'ajout de cette regle).
core/data/

# Exceptions : documentation et exemples de configuration
!logs/.gitkeep
!data/README.md
!data/*.example.json

# Configuration locale
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Worktrees
.claude/worktrees/

# Qwen Code settings
.qwen/settings.json

# WinSW/NSSM Logs
nssm/*.log
nssm/**/*.log

# Temporary files
start
$null

# Documentation (uniquement README et fichiers essentiels)
*.md
!README.md
!CHANGELOG.md
!QWEN.md
!*/README.md
!scripts/SIGNATURE_GUIDE.md
!AUDIT_*.md
!MIGRATION_*.md

# Ancienne documentation (obsolète)
DEBUG_GUIDE.md
DEPLOYMENT_CHECKLIST.md
GUIDE_INSTALLATION_WINDOWS.md
GUIDE_PERSONNALISATION.md
GUIDE_TEST_RESPONSIVE.md
INSTALL_AD_SERVER.md
MODULARITE.md
PROPOSITIONS_AMELIORATIONS.md
README_DOCUMENTATION.md
SECURITY.md

# Backup directories
backup_pre_update/

# Certificates
scripts/codesign.*
scripts/*.cer

# Fichiers de travail locaux
# NB: utiliser des slashes '/' — git n'interprete pas '\' comme separateur,
# les anciennes entrees en 'data\fichier.json' ne matchaient jamais.
.claude/settings.json
.claude/settings.local.json
core/data/settings.json
data/update_manifest.json
routes/tools/*.dat
routes/tools/test_write.txt
check_testino.py
check_testino_ad_rights.py
decode.ps1
server_address.txt
temp_b64.txt
temp_b64_clean.txt
test_flask.py
test_imports*.py
